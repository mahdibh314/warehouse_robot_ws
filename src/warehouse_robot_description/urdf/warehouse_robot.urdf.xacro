<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">

    <visual>
      <geometry>
        <box size="0.30 0.22 0.10"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.30 0.22 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

  </link>
</robot>